# Supabase "Transaction pooler" string (port 6543) — best for Vercel's serverless functions
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional: product analytics (posthog.com, free tier)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
